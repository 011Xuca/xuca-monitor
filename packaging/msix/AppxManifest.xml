<?xml version="1.0" encoding="utf-8"?>
<!-- Paquete MSIX para la Microsoft Store. El workflow .github/workflows/publicar.yml reemplaza __VERSION__ y __PUBLISHER__
     (el "Publisher" que da Partner Center, por ejemplo CN=XXXXXXXX-XXXX-...) y lo arma con makeappx.
     La Store firma el paquete: es la forma mas solida de que Defender/SmartScreen no lo traten como desconocido.
     allowElevation: Pulso pide administrador para leer los sensores (Partner Center pide justificarlo al enviarlo). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="011Xuca.Pulso" Publisher="__PUBLISHER__" Version="__VERSION__.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Pulso</DisplayName>
    <PublisherDisplayName>011Xuca</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="es" />
    <Resource Language="en" />
  </Resources>
  <Applications>
    <Application Id="Pulso" Executable="Pulso.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Pulso" Description="Monitoreo integral de la PC: red, USB, rendimiento, errores, hardware y grabación de sesiones."
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Alias fijo en %LOCALAPPDATA%\Microsoft\WindowsApps\Pulso.exe: lo usa "Iniciar con Windows" (App.cs, TareaExe) -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Pulso.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="Pulso.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
